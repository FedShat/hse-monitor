# Secrets: copy to .env. Never commit .env.
TELEGRAM_BOT_TOKEN=
# Your numeric user ID, equal to the private chat ID. Send /start to the bot.
TELEGRAM_CHAT_ID=
LMS_COOKIE_HEADER='MoodleSession=replace_me'
LMS_URL='https://edu.hse.ru/mod/selfgrouping/view.php?tab=slot&id=1887331'

# Poll start-to-start; one request at a time, minimum 1 second.
POLL_INTERVAL=3
REQUEST_TIMEOUT=20
# Refresh the HTML form and sesskey; this does NOT renew an expired SSO login.
AUTH_REFRESH_INTERVAL=300
MAX_BACKOFF=300

# Both flags must be set for actual booking: true + false respectively.
AUTOBOOK_ENABLED=false
AUTOBOOK_DRY_RUN=true
NOTIFY_TABLE_CHANGES=true
NOTIFY_INITIAL_AVAILABLE=true

# Empty filters = any future slot. SLOT_IDS order gives booking priority.
SLOT_IDS=
SLOT_NAME_REGEX=
# Inclusive date/time bounds, evaluated in TZ, e.g. 2026-11-02 and 09:00.
DATE_FROM=
DATE_TO=
TIME_FROM=
TIME_TO=
TZ=Europe/Moscow
STATE_PATH=data/state.sqlite3
